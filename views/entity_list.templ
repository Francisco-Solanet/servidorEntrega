package views

import "ejercicioEntrega.com/servidorEntrega/db"
import "fmt"

templ EntityList(vehiculos []db.Vehiculo) {
	<section id="entity-list">
		<h2>Vehículos registrados</h2>
		if len(vehiculos) == 0 {
			<p>Todavía no hay vehículos registrados.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Marca</th>
						<th>Modelo</th>
						<th>Año</th>
						<th>Precio</th>
						<th>Kilometraje</th>
						<th>Acciones</th>
					</tr>
				</thead>
				<tbody>
					for _, vehiculo := range vehiculos {
						<tr>
							<td>{ vehiculo.Marca }</td>
							<td>{ vehiculo.Modelo }</td>
							<td>{ fmt.Sprint(vehiculo.Anio) }</td>
							<td>$ { vehiculo.PrecioVenta }</td>
							<td>{ fmt.Sprint(vehiculo.Kilometraje) } km</td>
							<td>
								<button
									type="button"
									hx-delete={ fmt.Sprintf("/vehiculos/%d", vehiculo.ID) }
									hx-target="closest tr"
									hx-swap="outerHTML"
									hx-confirm="¿Estás seguro de que querés borrar este vehículo?"
								>
									Borrar
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}
